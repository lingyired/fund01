{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fund01",
  "version": "1.7.1",
  "identifier": "com.lingyi.fund01",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2NzAxNzdBMzQ2RTBCQjAKUldTd0MyNDBlaGR3ZHRnUjVJYStxSFcrYkV4QkMwWk5wTEJyMldJRGhrOS9nSjUwb3JVd0FsYWMK",
      "endpoints": [
        "https://lingai.net/fund01/latest.json",
        "https://gh-proxy.com/https://github.com/lingyired/fund01/releases/latest/download/latest.json",
        "https://github.com/lingyired/fund01/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
